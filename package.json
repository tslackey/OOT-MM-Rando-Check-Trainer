{
  "name": "oot-mm-rando-check-trainer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Practice Ocarina of Time randomizer checks without a tracker.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "cap:sync": "npm run build && cap sync",
    "generate:world": "python3 scripts/generate-world.py",
    "vendor:graph-cache": "node scripts/vendor-graph-cache.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.0",
    "@capacitor/core": "^7.4.3",
    "@capacitor/haptics": "^7.0.2",
    "@capacitor/preferences": "^7.0.2",
    "@mracsys/randomizer-graph-tool": "^2.1.18",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "browser": {
    "fs": false
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
